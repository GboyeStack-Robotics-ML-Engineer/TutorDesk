# Copy to .env and fill in once the Meta side (see META_SETUP.md) is done.
# Until then this runs fine with PROVIDER=dry — no account needed at all.

PROVIDER=dry

# --- Meta Cloud API (PROVIDER=meta) -----------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
# Invent any random string — must match what you enter in the Meta
# dashboard's webhook Verify Token field.
VERIFY_TOKEN=tutordesk-verify-dev
# Meta App Dashboard -> Settings -> Basic -> App Secret. Required to verify
# inbound webhooks are actually from Meta (X-Hub-Signature-256).
META_APP_SECRET=

# --- Twilio (PROVIDER=twilio, secondary/testing path — see docs/PRD.md) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- TutorDesk backend -------------------------------------------------------
DJANGO_API_BASE_URL=http://localhost:8000/api
# Must match INTERNAL_SERVICE_TOKEN in backend/.env exactly.
INTERNAL_SERVICE_TOKEN=dev-shared-secret-change-me
PUBLIC_WEB_BASE_URL=http://localhost:5173

DB_PATH=tutordesk_whatsapp.db
