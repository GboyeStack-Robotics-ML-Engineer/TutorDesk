# Copy this file to .env and adjust for your machine.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# never put a secret here, since anything here ships to the client.

# Base URL of the Django backend's API. See src/lib/api.js for the full
# endpoint contract this frontend expects (auth, students, classes).
VITE_API_BASE_URL=http://localhost:8000/api

# Lets you walk the /portal screens without a running backend or a real
# login — useful for local UI work before the backend track has auth ready.
# Leave unset (or false) everywhere else, including any deployed environment.
VITE_SKIP_AUTH=false
