# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Encrypts GoogleAccount's OAuth tokens at rest (core/fields.py). Generate a
# real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every already-stored token — connected
# tutors would need to reconnect Google.
FIELD_ENCRYPTION_KEY=change-me-to-a-real-fernet-key

# Leave unset for a local SQLite file. Set for Postgres, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/tutordesk
DATABASE_URL=

# Origins the frontend runs on — comma-separated. Vite's default dev port
# is already included as the fallback in settings.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the WhatsApp service (../whatsapp/). Leave blank to just log
# instead of calling out — see core/services/whatsapp.py.
WHATSAPP_SERVICE_URL=http://localhost:8001

# Shared secret for the two internal, non-user-authenticated calls between
# this backend and ../whatsapp/ (POST /onboarding/start and PATCH
# .../complete-onboarding/). Must match INTERNAL_SERVICE_TOKEN in
# whatsapp/.env exactly.
INTERNAL_SERVICE_TOKEN=dev-shared-secret-change-me

# Where the frontend runs — used to build links sent to users (Google OAuth
# redirect, password reset email, monthly report). Not the same as
# CORS_ALLOWED_ORIGINS above (that's for browser requests; this is for
# building URLs server-side).
FRONTEND_BASE_URL=http://localhost:5173

# Tutor password reset (core/services/password_reset.py) sends a real
# email. Leave EMAIL_BACKEND at the console default and nothing below
# matters — the reset link just prints to the runserver log. Set these to
# go live with real SMTP (e.g. SendGrid, SES, Mailgun):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@tutordesk.local
