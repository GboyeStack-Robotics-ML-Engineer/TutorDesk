# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for a local SQLite file. Set for Postgres, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/tutordesk
DATABASE_URL=

# Origins the frontend runs on — comma-separated. Vite's default dev port
# is already included as the fallback in settings.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the WhatsApp service (../whatsapp/). Leave blank to just log
# instead of calling out — see core/services/whatsapp.py.
WHATSAPP_SERVICE_URL=http://localhost:8001

# Shared secret for the two internal, non-user-authenticated calls between
# this backend and ../whatsapp/ (POST /onboarding/start and PATCH
# .../complete-onboarding/). Must match INTERNAL_SERVICE_TOKEN in
# whatsapp/.env exactly.
INTERNAL_SERVICE_TOKEN=dev-shared-secret-change-me
